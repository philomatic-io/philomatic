# Philomatic reverse-proxy example (Caddy v2 — automatic HTTPS).
#
# ONE ORIGIN, path-routed. Two processes, one hostname:
#
#   /            → the registry (library index, /t/* track pages, /signin, /auth/*, /account,
#                  /intro, /index.json, /publish …)                  — 127.0.0.1:4400
#   /app*        → the workbench + its API (run with BASE_PATH=/app)  — 127.0.0.1:4321
#   /assets/*    → the built UI bundle. BOTH processes read the same ui/dist, so routing all
#                  assets to the instance serves the registry's /t pages too (they reference
#                  /assets/public.js). Assets stay open (no auth): a 401 here would pop a login
#                  dialog on a public page, and they are the open-source bundle, no user data.
#
# Why one origin: the __Host- session cookie deliberately cannot span hostnames, and with the
# registry and the workbench on one origin the cookie signs you in EVERYWHERE while CORS simply
# never applies to first-party use. `my.philomatic.io` retires to a redirect below.
#
# Sign-in is the workbench's own (Google via the registry), so /app carries NO auth here — the
# session is the credential and the app offers the sign-in itself.
#
# NOTE the Caddyfile brace rule: `{` must END its line and `}` must be ALONE on its line —
# one-line blocks are a parse error, and a failed reload silently keeps the OLD config.

philomatic.io {
	# HSTS — https only, from the first visit onward. The __Host- session cookie is REQUIRED to
	# be Secure, so anything that lets a browser try http first is a downgrade window. One year,
	# subdomains included (there is only the redirect host below, which should also be https).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# The instance: the workbench (/app*, BASE_PATH=/app), the shared UI bundle, health + favicon.
	# Run the instance with BASE_PATH=/app — it strips the prefix itself; Caddy forwards untouched.
	@instance path /app /app/* /assets/* /favicon.ico /health
	handle @instance {
		reverse_proxy 127.0.0.1:4321
	}
	# Everything else → the registry: the library index, /t/* track pages, sign-in, accounts.
	handle {
		reverse_proxy 127.0.0.1:4400
	}
}

# The old hostname keeps working for links already in the wild.
my.philomatic.io {
	redir https://philomatic.io/app{uri} permanent
}
